{
  "name": "mossymc-docs",
  "version": "1.0.0",
  "description": "MossyMC 玩法文档",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && node -e \"const f=require('node:fs');f.cpSync('resource','docs/.vitepress/dist/resource',{recursive:true});f.rmSync('docs/.vitepress/dist/js',{recursive:true,force:true});f.cpSync('js','docs/.vitepress/dist/js',{recursive:true});['psych.html','cert.html','tools.html','project.html','project.css'].forEach(p=>f.copyFileSync(p,'docs/.vitepress/dist/'+p))\"",
    "docs:preview": "vitepress preview docs",
    "test:exam": "node smoke-exam.js"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "vitepress": "^1.5.0"
  }
}
