{
  "name": "mossymc-docs",
  "version": "1.0.0",
  "description": "MossyMC 玩法文档",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && node -e \"const f=require('node:fs');f.cpSync('resource','docs/.vitepress/dist/resource',{recursive:true});['psych.html','cert.html','tools.html','project.html'].forEach(p=>f.copyFileSync(p,'docs/.vitepress/dist/'+p))\"",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "vitepress": "^1.5.0"
  }
}
